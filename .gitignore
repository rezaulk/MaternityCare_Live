# React Native standard ignores

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock

# Logs
*.log
logs/
*.pid
*.seed
*.pid.lock

# React Native / Metro
.expo/
.expo-shared/
.expo-dev/
.rncache/
metro-cache/
*.bundle
*.map

# iOS
ios/build/
ios/Pods/
ios/Podfile.lock
ios/*.xcworkspace
ios/*/xcuserdata
ios/*/build
ios/.DS_Store
DerivedData/

# Android
android/.gradle/
android/.gradle/*
android/.idea/
android/local.properties
android/app/build/
android/build/
android/captures/
android/.cxx/
*.iml

# Sometimes Gradle caches go into project root
.gradle/
gradle-app.setting
build/
**/build/
**/bin/
**/obj/

# APK / ARTIFACTS
*.apk
*.ap_
*.aab
*.dex
*.class
*.so
*.jar
*.war
*.ear

# IDEs
.vscode/
.idea/
*.swp
*.swo
*.sln
*.suo
*.ntvs*
*.njsproj
*.xcodeproj
*.xcworkspace

# Fastlane
fastlane/report.xml
